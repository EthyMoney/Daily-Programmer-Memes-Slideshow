{
  "name": "daily-programmer-memes-slideshow",
  "version": "1.0.0",
  "description": "An Electron app that fetches and displays images from hot r/ProgrammerHumor posts.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "download": "node download-todays-memes.js",
    "lint": "eslint index.js preload.js renderer.js scheduler.js download-todays-memes.js logger.js config.js date-utils.js archive.js test",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "electron",
    "images",
    "reddit",
    "display",
    "desktop",
    "fun",
    "meme",
    "memes",
    "humor",
    "programmer-humor",
    "funny",
    "raspberry-pi"
  ],
  "author": "Logan S. (EthyMoney)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EthyMoney/Daily-Programmer-Memes-Slideshow.git"
  },
  "bugs": {
    "url": "https://github.com/EthyMoney/Daily-Programmer-Memes-Slideshow/issues"
  },
  "homepage": "https://github.com/EthyMoney/Daily-Programmer-Memes-Slideshow#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^42.7.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "fast-xml-parser": "^5.10.1",
    "node-cron": "^4.6.0"
  },
  "allowScripts": {
    "electron@42.7.0": true
  }
}
